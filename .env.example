# Copiá este archivo a ".env" (o ".env.local") y completá los valores.
# ".env" NUNCA se sube al repositorio (ver .gitignore).

# --- Base de datos (Supabase Postgres) ---
# Sacar estos dos valores del proyecto en Supabase: Project Settings → Database → ORM → Prisma
# (o el botón "Connect" del dashboard). Son DOS conexiones distintas, no la misma URL repetida:
#
# DATABASE_URL: pooler en modo transacción (puerto 6543, "?pgbouncer=true"). La usa la app
# en runtime (Prisma Client) — soporta muchas conexiones cortas simultáneas.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# DIRECT_URL: pooler en modo sesión (puerto 5432, sin pgbouncer). La usa Prisma Migrate
# (necesita funciones de sesión —advisory locks— que el modo transacción no soporta).
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres"
#
# Alternativa para desarrollo sin depender de internet/Supabase: el docker-compose.yml incluido
# levanta un Postgres local en el puerto 5433 (no 5432, para no chocar con otros proyectos).
# En ese caso alcanza con una sola URL para las dos variables:
# DATABASE_URL="postgresql://graan:graan_dev_local@localhost:5433/graan_studio?schema=public"
# DIRECT_URL="postgresql://graan:graan_dev_local@localhost:5433/graan_studio?schema=public"

# --- Cuentas iniciales (seed: npm run db:seed) ---
# Completar SOLO localmente. Si una cuenta no se necesita todavía, dejar sus 3 variables vacías/ausentes:
# esa cuenta simplemente no se crea. Usar contraseñas temporales: la primera vez que ingresen
# se les va a pedir cambiarla (mustChangePassword).

# OWNER — Graziella, acceso completo (incluye Métricas/financiero global).
OWNER_EMAIL=""
OWNER_TEMP_PASSWORD=""
OWNER_DISPLAY_NAME="Graziella"

# ADMIN — cuenta ÚNICA y compartida por Vicky y Amy (acceso operativo, sin Métricas).
ADMIN_EMAIL=""
ADMIN_TEMP_PASSWORD=""
ADMIN_DISPLAY_NAME="Vicky y Amy"

# DEV/soporte — Martina, mientras el sistema está en desarrollo. Marcada como isSupport=true
# para poder desactivarla/borrarla fácilmente más adelante.
DEV_EMAIL=""
DEV_TEMP_PASSWORD=""
DEV_DISPLAY_NAME="Martina (soporte)"

# --- Email (recuperación de contraseña) ---
# Sin configurar todavía: los emails se muestran por consola en desarrollo, no se envían.
# Cuando haya proveedor real (ej. Resend), cambiar EMAIL_PROVIDER y agregar su API key acá.
EMAIL_PROVIDER="console"
# RESEND_API_KEY=""

# --- Almacenamiento privado (comprobantes) ---
# Sin configurar todavía: usa disco local en ".private-uploads" (fuera de /public, gitignored).
# Cuando haya proveedor real (Vercel Blob, S3, Supabase Storage), cambiar STORAGE_DRIVER.
STORAGE_DRIVER="local"
